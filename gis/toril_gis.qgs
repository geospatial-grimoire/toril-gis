# ---------------- Project variable signal ----------------&#13;
def _connect_variable_signal():&#13;
    global __var_sig_conn&#13;
    global __distance_units_sig_conn, __area_units_sig_conn&#13;
&#13;
    project = QgsProject.instance()&#13;
&#13;
    try:&#13;
        if hasattr(project, "customVariablesChanged"):&#13;
            if __var_sig_conn is not None:&#13;
                try:&#13;
                    project.customVariablesChanged.disconnect(__var_sig_conn)&#13;
                except Exception:&#13;
                    pass&#13;
&#13;
            def _on_vars_changed():&#13;
                if __suppress_var_events:&#13;
                    return&#13;
                try:&#13;
                    _sync_from_vars()&#13;
                except Exception as error:&#13;
                    _log_exc("Variable synchronization failed", error)&#13;
&#13;
            project.customVariablesChanged.connect(_on_vars_changed)&#13;
            __var_sig_conn = _on_vars_changed&#13;
&#13;
        def _on_native_units_changed():&#13;
            if __suppress_var_events:&#13;
                return&#13;
&#13;
            inferred = _measure_system_from_project_units()&#13;
            if inferred in __MEASURE_SYSTEMS:&#13;
                try:&#13;
                    _set_project_var("TG_CONFIG_MEASURE_SYSTEM", inferred)&#13;
                except Exception as error:&#13;
                    _log_exc("Could not synchronize measurement variable", error)&#13;
&#13;
            _sync_measure_combo()&#13;
            _schedule_refresh(delay_ms=0, reason="native measure units changed")&#13;
&#13;
        for signal_name, connection_name in (&#13;
            ("distanceUnitsChanged", "distance"),&#13;
            ("areaUnitsChanged", "area"),&#13;
        ):&#13;
            signal = getattr(project, signal_name, None)&#13;
            if signal is None:&#13;
                continue&#13;
&#13;
            try:&#13;
                signal.connect(_on_native_units_changed)&#13;
                if connection_name == "distance":&#13;
                    __distance_units_sig_conn = _on_native_units_changed&#13;
                else:&#13;
                    __area_units_sig_conn = _on_native_units_changed&#13;
            except Exception as error:&#13;
                _log_exc(f"Could not connect {signal_name}", error)&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Project signal connection failed", error)&#13;
&#13;
&#13;
# ---------------- Teardown and initialization ----------------&#13;
def _teardown():&#13;
    global __tg_toolbar&#13;
    global __lbl_udk, __lbl_ed, __lbl_disp, __lbl_measure&#13;
    global __lang_combo, __udk_combo, __ed_combo, __disp_combo&#13;
    global __search_combo, __measure_combo, __docs_button, __web_map_button, __welcome_button, __feedback_button, __var_sig_conn&#13;
    global __distance_units_sig_conn, __area_units_sig_conn&#13;
    global __suppress_var_events, __refresh_pending, __refresh_running&#13;
    global __ui_lang, __search_revision, __search_last_query&#13;
    global __search_selected_layer_id, __search_selected_feature_id&#13;
    global __welcome_dialog&#13;
&#13;
    _clear_previous_search_selection()&#13;
&#13;
    try:&#13;
        if __welcome_dialog is not None:&#13;
            __welcome_dialog.close()&#13;
    except Exception:&#13;
        pass&#13;
    __welcome_dialog = None&#13;
&#13;
    try:&#13;
        project = QgsProject.instance()&#13;
        if (&#13;
            __var_sig_conn is not None&#13;
            and hasattr(project, "customVariablesChanged")&#13;
        ):&#13;
            try:&#13;
                project.customVariablesChanged.disconnect(__var_sig_conn)&#13;
            except Exception:&#13;
                pass&#13;
&#13;
        if (&#13;
            __distance_units_sig_conn is not None&#13;
            and hasattr(project, "distanceUnitsChanged")&#13;
        ):&#13;
            try:&#13;
                project.distanceUnitsChanged.disconnect(&#13;
                    __distance_units_sig_conn&#13;
                )&#13;
            except Exception:&#13;
                pass&#13;
&#13;
        if (&#13;
            __area_units_sig_conn is not None&#13;
            and hasattr(project, "areaUnitsChanged")&#13;
        ):&#13;
            try:&#13;
                project.areaUnitsChanged.disconnect(__area_units_sig_conn)&#13;
            except Exception:&#13;
                pass&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    try:&#13;
        if __tg_toolbar is not None:&#13;
            try:&#13;
                iface.mainWindow().removeToolBar(__tg_toolbar)&#13;
            except Exception:&#13;
                pass&#13;
            try:&#13;
                __tg_toolbar.deleteLater()&#13;
            except Exception:&#13;
                pass&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    __tg_toolbar = None&#13;
&#13;
    __lbl_udk = None&#13;
    __lbl_ed = None&#13;
    __lbl_disp = None&#13;
    __lbl_measure = None&#13;
&#13;
    __lang_combo = None&#13;
    __udk_combo = None&#13;
    __ed_combo = None&#13;
    __disp_combo = None&#13;
    __search_combo = None&#13;
    __measure_combo = None&#13;
    __docs_button = None&#13;
    __web_map_button = None&#13;
    __welcome_button = None&#13;
    __feedback_button = None&#13;
&#13;
    __var_sig_conn = None&#13;
    __distance_units_sig_conn = None&#13;
    __area_units_sig_conn = None&#13;
&#13;
    __suppress_var_events = False&#13;
    __refresh_pending = False&#13;
    __refresh_running = False&#13;
&#13;
    __ui_lang = None&#13;
&#13;
    __search_revision += 1&#13;
    __search_last_query = ""&#13;
    __search_selected_layer_id = None&#13;
    __search_selected_feature_id = None&#13;
&#13;
&#13;
def _ui_ready():&#13;
    try:&#13;
        main_window = iface.mainWindow()&#13;
        if main_window is None:&#13;
            return False&#13;
&#13;
        if not main_window.isVisible():&#13;
            return False&#13;
&#13;
        if iface.mapCanvas() is None:&#13;
            return False&#13;
&#13;
        return True&#13;
&#13;
    except Exception:&#13;
        return False&#13;
&#13;
&#13;
def _init_ui_after_project_open():&#13;
    global __init_attempts&#13;
    __init_attempts += 1&#13;
&#13;
    try:&#13;
        if not _ui_ready():&#13;
            if __init_attempts &lt; __MAX_INIT_ATTEMPTS:&#13;
                QTimer.singleShot(400, _init_ui_after_project_open)&#13;
            return&#13;
&#13;
        _ensure_project_vars()&#13;
        _build_toolbar()&#13;
        _connect_variable_signal()&#13;
        _sync_from_vars()&#13;
        QTimer.singleShot(700, _show_welcome_dialog_if_needed)&#13;
&#13;
        try:&#13;
            if __tg_toolbar is not None:&#13;
                __tg_toolbar.show()&#13;
                __tg_toolbar.setVisible(True)&#13;
                __tg_toolbar.raise_()&#13;
        except Exception:&#13;
            pass&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("_init_ui_after_project_open error", error, push=True)&#13;
&#13;
&#13;
# ---------------- QGIS macro entry points ----------------&#13;
def openProject():&#13;
    global __init_attempts&#13;
    __init_attempts = 0&#13;
&#13;
    try:&#13;
        QTimer.singleShot(500, _init_ui_after_project_open)&#13;
    except Exception as error:&#13;
        _log_exc("openProject error", error, push=True)&#13;
&#13;
&#13;
def saveProject():&#13;
    try:&#13;
        _sync_from_vars()&#13;
    except Exception as error:&#13;
        _log_exc("saveProject error", error, push=True)&#13;
&#13;
&#13;
def closeProject():&#13;
    try:&#13;
        _teardown()&#13;
    except Exception as error:&#13;
        _log_exc("closeProject error", error, push=True)&#13;
