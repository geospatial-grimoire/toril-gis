      <expressionfields>
        <field comment="" expression="&quot;geog_extent&quot; ['centroid']['md']" length="-1" name="centroid" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="CASE &#13;&#10;    WHEN geometry_type(@geometry) = 'Polygon' &#13;&#10;    THEN CONCAT(&#13;&#10;        'perimeter: ', &quot;geog_extent&quot;['perimeter'][@TG_CONFIG_MEASURE_SYSTEM], ' ', EVAL(@tg_f_measure_length_unit),&#13;&#10;        ' | area: ', &quot;geog_extent&quot;['area'][@TG_CONFIG_MEASURE_SYSTEM], ' ', EVAL(@tg_f_measure_area_unit)&#13;&#10;    )&#13;&#10;    WHEN geometry_type(@geometry) = 'Line' &#13;&#10;    THEN CONCAT(&#13;&#10;        'length: ', &quot;geog_extent&quot;['length'][@TG_CONFIG_MEASURE_SYSTEM ], ' ', EVAL(@tg_f_measure_length_unit)&#13;&#10;    )&#13;&#10;    ELSE NULL&#13;&#10;END" length="-1" name="measurements" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="array_to_string(coalesce(map_get(&quot;location_paths&quot;, @TG_CONFIG_LANG), map_get(&quot;location_paths&quot;, 'en')), ' → ')" length="-1" name="location" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="with_variable(&#13;&#10;    'source_feature',&#13;&#10;    get_feature('Map Sources', 'uuid', attribute($currentfeature, 'source')),&#13;&#10;    format(&#13;&#10;        '&lt;a href=''%1''&gt;%2 %3&lt;/a&gt;',&#13;&#10;        attribute(@source_feature, 'url'),&#13;&#10;        attribute(@source_feature, 'title'),&#13;&#10;        attribute(@source_feature, 'descr')&#13;&#10;    )&#13;&#10;)" length="-1" name="source_citation" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="with_variable(&#13;&#10;    'source_feature',&#13;&#10;    get_feature('Map Sources', 'uuid', attribute($currentfeature, 'source')),&#13;&#10;    format(&#13;&#10;        '&lt;a href=''%1''&gt;%2 %3&lt;/a&gt;',&#13;&#10;        attribute(@source_feature, 'url'),&#13;&#10;        attribute(@source_feature, 'title'),&#13;&#10;        attribute(@source_feature, 'descr')&#13;&#10;    )&#13;&#10;)" length="-1" name="source_citation" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="-- This expression generates an HTML hyperlink for the usage terms.&#13;&#10;-- It performs a two-step lookup: first to 'map_sources' to get the&#13;&#10;-- 'usage_terms' uuid, and then to the 'usage_terms' layer to get the final details.&#13;&#10;&#13;&#10;with_variable(&#13;&#10;    'usage_terms_uuid',&#13;&#10;    attribute(get_feature('Map Sources', 'uuid', attribute($currentfeature, 'source')), 'usage_terms'),&#13;&#10;    with_variable(&#13;&#10;        'terms_feature',&#13;&#10;        get_feature('Usage Terms', 'uuid', @usage_terms_uuid),&#13;&#10;        format(&#13;&#10;            '&lt;a href=''%1''&gt;%2&lt;/a&gt;',&#13;&#10;            attribute(@terms_feature, 'url'),&#13;&#10;            attribute(@terms_feature, 'descr')&#13;&#10;        )&#13;&#10;    )&#13;&#10;)" length="-1" name="usage_terms" precision="0" subType="0" type="10" typeName="text"/>
      </expressionfields>
      <attributeactions>
        <defaultAction key="Canvas" value="{61828f62-0db2-4bba-91df-a44d6e13bc98}"/>
        <actionsetting action="[%CASE WHEN nullif(ATTRIBUTE('url_' || @TG_CONFIG_LANG), '') IS NOT NULL&#13;&#10;&#9; THEN ATTRIBUTE('url_' || @TG_CONFIG_LANG)&#13;&#10;&#9; ELSE nullif(ATTRIBUTE('url_en'), '')&#13;&#10;END%]" capture="0" icon="" id="{8c3351dd-f0b6-4971-9d59-e11203129876}" isEnabledOnlyWhenEditable="0" name="Open in Forgotten Realms Wiki" notificationMessage="" shortTitle="🔗FR Wiki" type="5">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="[%eval ( @tg_f_wiki_auto_link )%]" capture="0" icon="" id="{ef512053-1d29-44ae-a470-84dac093d730}" isEnabledOnlyWhenEditable="0" name="Open in Forgotten Realms Wiki (Autogenerated)" notificationMessage="" shortTitle="FR Wiki (Autogenerated)" type="5">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="[%eval ( @tg_f_te_auto_link )%]" capture="0" icon="" id="{5822a2f0-c557-4adf-8b4e-60d53c7bac26}" isEnabledOnlyWhenEditable="0" name="Open in Toril Explorer interactive map" notificationMessage="" shortTitle="🌐Toril Explorer" type="5">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="from qgis.PyQt.QtWidgets import QApplication&#13;&#10;from qgis.utils import iface&#13;&#10;&#13;&#10;uuid_value = &quot;&quot;&quot;[% coalesce(&quot;uuid&quot;, '') %]&quot;&quot;&quot;.strip()&#13;&#10;&#13;&#10;if uuid_value:&#13;&#10;    QApplication.clipboard().setText(uuid_value)&#13;&#10;    iface.messageBar().pushSuccess(&#13;&#10;        &quot;Toril GIS&quot;,&#13;&#10;        f&quot;UUID copied: {uuid_value}&quot;&#13;&#10;    )&#13;&#10;else:&#13;&#10;    iface.messageBar().pushWarning(&#13;&#10;        &quot;Toril GIS&quot;,&#13;&#10;        &quot;This feature has no UUID.&quot;&#13;&#10;    )" capture="0" icon="" id="{6c482d65-e927-4bc3-a4b9-1e9d38a4b5b1}" isEnabledOnlyWhenEditable="0" name="Copy this feature’s UUID to the clipboard" notificationMessage="" shortTitle="🆔Copy UUID" type="1">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="from qgis.core import QgsProject, QgsVectorLayer, Qgis&#13;&#10;from qgis.utils import iface&#13;&#10;&#13;&#10;# Retrieve current layer context and feature ID from QGIS variables&#13;&#10;layer_id = '[% @layer_id %]'&#13;&#10;feature_id = [% $id %]&#13;&#10;&#13;&#10;layer = QgsProject.instance().mapLayer(layer_id)&#13;&#10;&#13;&#10;if layer and isinstance(layer, QgsVectorLayer):&#13;&#10;    idx = layer.fields().indexOf('needs_review')&#13;&#10;    &#13;&#10;    if idx == -1:&#13;&#10;        iface.messageBar().pushWarning(&#13;&#10;            &quot;Needs Review&quot;, &#13;&#10;            f&quot;Field 'needs_review' does not exist in layer '{layer.name()}'.&quot;&#13;&#10;        )&#13;&#10;    else:&#13;&#10;        # Automatically toggle layer editing mode if it is currently closed&#13;&#10;        was_editing = layer.isEditable()&#13;&#10;        if not was_editing:&#13;&#10;            layer.startEditing()&#13;&#10;&#13;&#10;        feature = layer.getFeature(feature_id)&#13;&#10;        current_val = bool(feature['needs_review'])&#13;&#10;        new_val = not current_val&#13;&#10;&#13;&#10;        # Update the attribute value&#13;&#10;        if layer.changeAttributeValue(feature_id, idx, new_val):&#13;&#10;            layer.triggerRepaint()&#13;&#10;            status_str = &quot;needs review (TRUE)&quot; if new_val else &quot;reviewed (FALSE)&quot;&#13;&#10;            &#13;&#10;            # Try fetching English name for notification, fallback to 'unnamed'&#13;&#10;            feat_name = feature.attribute('name_en') if 'name_en' in layer.fields().names() else None&#13;&#10;            label = f&quot; ('{feat_name}')&quot; if feat_name else &quot;&quot;&#13;&#10;            &#13;&#10;            # Use pushInfo for compatibility with QGIS 4.x message bar API&#13;&#10;            iface.messageBar().pushInfo(&#13;&#10;                &quot;Needs Review Toggle&quot;, &#13;&#10;                f&quot;Feature ID {feature_id}{label}: status changed to '{status_str}'.&quot;&#13;&#10;            )&#13;&#10;        else:&#13;&#10;            iface.messageBar().pushCritical(&#13;&#10;                &quot;Needs Review&quot;, &#13;&#10;                f&quot;Failed to update feature ID {feature_id}.&quot;&#13;&#10;            )" capture="0" icon="" id="{61828f62-0db2-4bba-91df-a44d6e13bc98}" isEnabledOnlyWhenEditable="0" name="Instantly toggles the boolean field needs_review on the clicked feature and updates the canvas." notificationMessage="" shortTitle="Toggle Review" type="1">
          <actionScope id="Canvas"/>
          <actionScope id="Feature"/>
        </actionsetting>
      </attributeactions>
