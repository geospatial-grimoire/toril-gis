# ---------------- Search configuration ----------------&#13;
__SEARCH_EXCLUDED_LAYER_NAMES = {"linestrings_v", "polygons_v", "points_v"}&#13;
__SEARCH_MIN_CHARS = 2&#13;
__SEARCH_DELAY_MS = 300&#13;
__SEARCH_RESULT_LIMIT = 50&#13;
__SEARCH_CANDIDATES_PER_LAYER = 250&#13;
&#13;
&#13;
# ---------------- Global UI state ----------------&#13;
__tg_toolbar = None&#13;
&#13;
__lbl_udk = None&#13;
__lbl_ed = None&#13;
__lbl_disp = None&#13;
__lbl_measure = None&#13;
&#13;
__lang_combo = None&#13;
__udk_combo = None&#13;
__ed_combo = None&#13;
__disp_combo = None&#13;
__search_combo = None&#13;
__measure_combo = None&#13;
__docs_button = None&#13;
__web_map_button = None&#13;
__welcome_button = None&#13;
__feedback_button = None&#13;
&#13;
__var_sig_conn = None&#13;
__distance_units_sig_conn = None&#13;
__area_units_sig_conn = None&#13;
&#13;
__init_attempts = 0&#13;
__MAX_INIT_ATTEMPTS = 10&#13;
&#13;
__LOG_TAG = "TorilGIS"&#13;
&#13;
__suppress_var_events = False&#13;
__refresh_pending = False&#13;
__refresh_running = False&#13;
&#13;
__ui_lang = None&#13;
&#13;
__search_revision = 0&#13;
__search_last_query = ""&#13;
__search_selected_layer_id = None&#13;
__search_selected_feature_id = None&#13;
&#13;
__welcome_dialog = None&#13;
&#13;
&#13;
# ---------------- Logging and state helpers ----------------&#13;
def _log(msg, level=Qgis.MessageLevel.Info, push=False, duration=4):&#13;
    try:&#13;
        QgsMessageLog.logMessage(str(msg), __LOG_TAG, level=level)&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    if push:&#13;
        try:&#13;
            iface.messageBar().pushMessage(&#13;
                "TorilGIS", str(msg), level=level, duration=duration&#13;
            )&#13;
        except Exception:&#13;
            pass&#13;
&#13;
&#13;
def _log_exc(prefix, error, push=False):&#13;
    _log(&#13;
        f"{prefix}: {type(error).__name__}: {error}",&#13;
        level=Qgis.MessageLevel.Warning,&#13;
        push=push,&#13;
        duration=8,&#13;
    )&#13;
&#13;
&#13;
def _begin_var_update():&#13;
    global __suppress_var_events&#13;
    __suppress_var_events = True&#13;
&#13;
&#13;
def _end_var_update():&#13;
    global __suppress_var_events&#13;
    __suppress_var_events = False&#13;
&#13;
&#13;
def _text(lang=None):&#13;
    if lang not in __LANGS:&#13;
        lang = _current_language()&#13;
    return __UI_TEXTS.get(lang, __UI_TEXTS["en"])&#13;
&#13;
&#13;
def _current_language():&#13;
    try:&#13;
        scope = QgsExpressionContextUtils.projectScope(QgsProject.instance())&#13;
        lang = scope.variable("TG_CONFIG_LANG")&#13;
        if lang in __LANGS:&#13;
            return lang&#13;
    except Exception:&#13;
        pass&#13;
    return "en"&#13;
&#13;
&#13;
# ---------------- Refresh ----------------&#13;
def _schedule_refresh(delay_ms=150, reason="unspecified"):&#13;
    global __refresh_pending&#13;
&#13;
    if __refresh_running or __refresh_pending:&#13;
        return&#13;
&#13;
    __refresh_pending = True&#13;
&#13;
    def _run():&#13;
        global __refresh_pending&#13;
        __refresh_pending = False&#13;
        _hard_refresh(reason)&#13;
&#13;
    QTimer.singleShot(delay_ms, _run)&#13;
&#13;
&#13;
def _hard_refresh(reason="unspecified"):&#13;
    global __refresh_running&#13;
&#13;
    if __refresh_running:&#13;
        return&#13;
&#13;
    __refresh_running = True&#13;
&#13;
    try:&#13;
        canvas = iface.mapCanvas()&#13;
        if canvas is None:&#13;
            return&#13;
&#13;
        try:&#13;
            for layer in QgsProject.instance().mapLayers().values():&#13;
                try:&#13;
                    layer.triggerRepaint()&#13;
                except Exception:&#13;
                    pass&#13;
        except Exception as error:&#13;
            _log_exc("_hard_refresh layer loop failed", error)&#13;
&#13;
        try:&#13;
            canvas.refresh()&#13;
        except Exception as error:&#13;
            _log_exc("mapCanvas.refresh failed", error)&#13;
&#13;
        try:&#13;
            canvas.refreshAllLayers()&#13;
        except Exception:&#13;
            pass&#13;
&#13;
        if reason == "udk changed":&#13;
&#13;
            def _second_pass():&#13;
                try:&#13;
                    for layer in QgsProject.instance().mapLayers().values():&#13;
                        try:&#13;
                            layer.triggerRepaint()&#13;
                        except Exception:&#13;
                            pass&#13;
                    canvas.refresh()&#13;
                except Exception:&#13;
                    pass&#13;
&#13;
            QTimer.singleShot(350, _second_pass)&#13;
&#13;
    finally:&#13;
        __refresh_running = False&#13;
&#13;
&#13;
# ---------------- Project and global variables ----------------&#13;
def _remove_project_variable(name):&#13;
    project = QgsProject.instance()&#13;
&#13;
    try:&#13;
        QgsExpressionContextUtils.removeProjectVariable(project, name)&#13;
        return True&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    try:&#13;
        project.removeCustomVariable(name)&#13;
        return True&#13;
    except Exception:&#13;
        return False&#13;
&#13;
&#13;
def _ensure_project_vars():&#13;
    project = QgsProject.instance()&#13;
    scope = QgsExpressionContextUtils.projectScope(project)&#13;
&#13;
    _begin_var_update()&#13;
    try:&#13;
        if scope.variable("TG_CONFIG_LANG") not in __LANGS:&#13;
            QgsExpressionContextUtils.setProjectVariable(&#13;
                project, "TG_CONFIG_LANG", "en"&#13;
            )&#13;
&#13;
        if scope.variable("TG_CONFIG_UDK_LEVEL") not in __UDK_LEVELS:&#13;
            QgsExpressionContextUtils.setProjectVariable(&#13;
                project, "TG_CONFIG_UDK_LEVEL", "All"&#13;
            )&#13;
&#13;
        if scope.variable("TG_CONFIG_DND_EDITION") not in __EDITIONS:&#13;
            QgsExpressionContextUtils.setProjectVariable(&#13;
                project, "TG_CONFIG_DND_EDITION", "All"&#13;
            )&#13;
&#13;
        measure_system = scope.variable("TG_CONFIG_MEASURE_SYSTEM")&#13;
        if measure_system not in __MEASURE_SYSTEMS:&#13;
            measure_system = _measure_system_from_project_units() or "metric"&#13;
            QgsExpressionContextUtils.setProjectVariable(&#13;
                project, "TG_CONFIG_MEASURE_SYSTEM", measure_system&#13;
            )&#13;
&#13;
        _set_project_measure_units(measure_system)&#13;
&#13;
        # Display settings are machine-specific. Remove old project-scoped&#13;
        # copies so the global/user values are not shadowed.&#13;
        for name in ("TG_CONFIG_DISPLAY_DPI", "TG_CONFIG_DISPLAY_SCALE"):&#13;
            if scope.variable(name) is not None:&#13;
                _remove_project_variable(name)&#13;
&#13;
        global_scope = QgsExpressionContextUtils.globalScope()&#13;
        dpi = global_scope.variable("TG_CONFIG_DISPLAY_DPI")&#13;
        scale = global_scope.variable("TG_CONFIG_DISPLAY_SCALE")&#13;
&#13;
        try:&#13;
            dpi_valid = float(dpi) &gt; 0&#13;
        except Exception:&#13;
            dpi_valid = False&#13;
&#13;
        try:&#13;
            scale_valid = float(scale) &gt; 0&#13;
        except Exception:&#13;
            scale_valid = False&#13;
&#13;
        if not dpi_valid:&#13;
            QgsExpressionContextUtils.setGlobalVariable(&#13;
                "TG_CONFIG_DISPLAY_DPI",&#13;
                __DISPLAY_PROFILES["size_100"]["dpi"],&#13;
            )&#13;
&#13;
        if not scale_valid:&#13;
            QgsExpressionContextUtils.setGlobalVariable(&#13;
                "TG_CONFIG_DISPLAY_SCALE",&#13;
                __DISPLAY_PROFILES["size_100"]["scale"],&#13;
            )&#13;
&#13;
    finally:&#13;
        _end_var_update()&#13;
&#13;
&#13;
def _set_project_vars(values):&#13;
    """Atomically update project custom variables while preserving all others."""&#13;
    global __suppress_var_events&#13;
&#13;
    project = QgsProject.instance()&#13;
&#13;
    try:&#13;
        current_variables = dict(project.customVariables())&#13;
    except Exception:&#13;
        current_variables = {}&#13;
&#13;
    changed_values = {&#13;
        name: value&#13;
        for name, value in values.items()&#13;
        if str(current_variables.get(name)) != str(value)&#13;
    }&#13;
    if not changed_values:&#13;
        return False&#13;
&#13;
    updated_variables = dict(current_variables)&#13;
    updated_variables.update(changed_values)&#13;
&#13;
    previous_suppression = __suppress_var_events&#13;
    __suppress_var_events = True&#13;
    try:&#13;
        project.setCustomVariables(updated_variables)&#13;
        try:&#13;
            project.setDirty(True)&#13;
        except Exception:&#13;
            pass&#13;
    finally:&#13;
        __suppress_var_events = previous_suppression&#13;
&#13;
    # Read back from a fresh scope so failures are visible in the QGIS log.&#13;
    verification_scope = QgsExpressionContextUtils.projectScope(project)&#13;
    failed = [&#13;
        name&#13;
        for name, value in changed_values.items()&#13;
        if str(verification_scope.variable(name)) != str(value)&#13;
    ]&#13;
    if failed:&#13;
        raise RuntimeError(&#13;
            "Project variables were not updated: " + ", ".join(failed)&#13;
        )&#13;
&#13;
    return True&#13;
&#13;
&#13;
def _set_project_var(name, value):&#13;
    return _set_project_vars({name: value})&#13;
&#13;
&#13;
def _set_global_var(name, value):&#13;
    scope = QgsExpressionContextUtils.globalScope()&#13;
    current = scope.variable(name)&#13;
&#13;
    if str(current) == str(value):&#13;
        return False&#13;
&#13;
    QgsExpressionContextUtils.setGlobalVariable(name, value)&#13;
    return True&#13;
&#13;
&#13;
def _display_values():&#13;
    scope = QgsExpressionContextUtils.globalScope()&#13;
    return (&#13;
        scope.variable("TG_CONFIG_DISPLAY_DPI"),&#13;
        scope.variable("TG_CONFIG_DISPLAY_SCALE"),&#13;
    )&#13;
&#13;
&#13;
def _apply_lang(lang):&#13;
    try:&#13;
        if lang not in __LANGS:&#13;
            return&#13;
&#13;
        changed = _set_project_var("TG_CONFIG_LANG", lang)&#13;
        _retranslate_toolbar(lang)&#13;
&#13;
        if changed:&#13;
            _schedule_refresh(reason="lang changed")&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Language apply error", error, push=True)&#13;
&#13;
&#13;
def _apply_udk(level):&#13;
    try:&#13;
        if level not in __UDK_LEVELS:&#13;
            return&#13;
&#13;
        changed = _set_project_var("TG_CONFIG_UDK_LEVEL", level)&#13;
        if changed:&#13;
            _schedule_refresh(reason="udk changed")&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Depth apply error", error, push=True)&#13;
&#13;
&#13;
def _apply_edition(edition):&#13;
    try:&#13;
        if edition not in __EDITIONS:&#13;
            return&#13;
&#13;
        changed = _set_project_var("TG_CONFIG_DND_EDITION", edition)&#13;
        if changed:&#13;
            _schedule_refresh(reason="edition changed")&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Edition apply error", error, push=True)&#13;
&#13;
&#13;
def _measure_system_from_project_units():&#13;
    """Infer metric/imperial only when both native project units match."""&#13;
    try:&#13;
        project = QgsProject.instance()&#13;
        if (&#13;
            project.distanceUnits() == Qgis.DistanceUnit.Miles&#13;
            and project.areaUnits() == Qgis.AreaUnit.SquareMiles&#13;
        ):&#13;
            return "imperial"&#13;
        if (&#13;
            project.distanceUnits() == Qgis.DistanceUnit.Kilometers&#13;
            and project.areaUnits() == Qgis.AreaUnit.SquareKilometers&#13;
        ):&#13;
            return "metric"&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    return None&#13;
&#13;
&#13;
def _measure_units_match(system):&#13;
    if system not in __MEASURE_SYSTEMS:&#13;
        return False&#13;
&#13;
    try:&#13;
        project = QgsProject.instance()&#13;
        config = __MEASURE_UNITS[system]&#13;
        return (&#13;
            project.distanceUnits() == config["distance"]&#13;
            and project.areaUnits() == config["area"]&#13;
        )&#13;
    except Exception:&#13;
        return False&#13;
&#13;
&#13;
def _set_project_measure_units(system):&#13;
    """Update native QGIS project distance and area units."""&#13;
    if system not in __MEASURE_SYSTEMS:&#13;
        return False&#13;
&#13;
    project = QgsProject.instance()&#13;
    config = __MEASURE_UNITS[system]&#13;
    before_distance = project.distanceUnits()&#13;
    before_area = project.areaUnits()&#13;
&#13;
    project.setDistanceUnits(config["distance"])&#13;
    project.setAreaUnits(config["area"])&#13;
&#13;
    changed = (&#13;
        before_distance != project.distanceUnits()&#13;
        or before_area != project.areaUnits()&#13;
    )&#13;
&#13;
    try:&#13;
        project.setDirty(True)&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    if not _measure_units_match(system):&#13;
        raise RuntimeError(&#13;
            "QGIS project distance/area units were not updated correctly"&#13;
        )&#13;
&#13;
    return changed&#13;
&#13;
&#13;
def _current_measure_system():&#13;
    inferred = _measure_system_from_project_units()&#13;
    if inferred in __MEASURE_SYSTEMS:&#13;
        return inferred&#13;
&#13;
    try:&#13;
        scope = QgsExpressionContextUtils.projectScope(QgsProject.instance())&#13;
        system = scope.variable("TG_CONFIG_MEASURE_SYSTEM")&#13;
        if system in __MEASURE_SYSTEMS:&#13;
            return system&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    return "metric"&#13;
&#13;
&#13;
def _apply_measure_system(system):&#13;
    global __suppress_var_events&#13;
&#13;
    if system not in __MEASURE_SYSTEMS:&#13;
        return&#13;
&#13;
    previous_suppression = __suppress_var_events&#13;
    __suppress_var_events = True&#13;
    try:&#13;
        project = QgsProject.instance()&#13;
        units_changed = _set_project_measure_units(system)&#13;
&#13;
        scope = QgsExpressionContextUtils.projectScope(project)&#13;
        variable_changed = str(scope.variable("TG_CONFIG_MEASURE_SYSTEM")) != system&#13;
        if variable_changed:&#13;
            QgsExpressionContextUtils.setProjectVariable(&#13;
                project, "TG_CONFIG_MEASURE_SYSTEM", system&#13;
            )&#13;
&#13;
        try:&#13;
            project.setDirty(True)&#13;
        except Exception:&#13;
            pass&#13;
&#13;
        verification_scope = QgsExpressionContextUtils.projectScope(project)&#13;
        if verification_scope.variable("TG_CONFIG_MEASURE_SYSTEM") != system:&#13;
            raise RuntimeError("TG_CONFIG_MEASURE_SYSTEM was not updated")&#13;
        if not _measure_units_match(system):&#13;
            raise RuntimeError("Native QGIS measurement units do not match selection")&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Measurement system apply error", error, push=True)&#13;
        return&#13;
    finally:&#13;
        __suppress_var_events = previous_suppression&#13;
&#13;
    _sync_measure_combo()&#13;
    _schedule_refresh(delay_ms=0, reason="measure system changed")&#13;
&#13;
&#13;
def _apply_display(profile_id):&#13;
    try:&#13;
        if profile_id not in __DISPLAY_PROFILES:&#13;
            return&#13;
&#13;
        config = __DISPLAY_PROFILES[profile_id]&#13;
        changed_dpi = _set_global_var("TG_CONFIG_DISPLAY_DPI", config["dpi"])&#13;
        changed_scale = _set_global_var(&#13;
            "TG_CONFIG_DISPLAY_SCALE", config["scale"]&#13;
        )&#13;
&#13;
        if changed_dpi or changed_scale:&#13;
            _schedule_refresh(reason="display changed")&#13;
&#13;
        _sync_display_combo()&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Display apply error", error, push=True)&#13;
&#13;
&#13;
def _detect_display_profile(dpi, scale):&#13;
    try:&#13;
        dpi_value = float(dpi)&#13;
        scale_value = float(scale)&#13;
    except Exception:&#13;
        return None&#13;
&#13;
    for profile_id, config in __DISPLAY_PROFILES.items():&#13;
        try:&#13;
            if (&#13;
                abs(float(config["dpi"]) - dpi_value) &lt; 0.000001&#13;
                and abs(float(config["scale"]) - scale_value) &lt; 0.000001&#13;
            ):&#13;
                return profile_id&#13;
        except Exception:&#13;
            continue&#13;
&#13;
    return None&#13;
&#13;
&#13;
# ---------------- First-run welcome dialog ----------------&#13;
def _welcome_seen():&#13;
    try:&#13;
        stored_version = QSettings().value(__WELCOME_SETTINGS_KEY, 0)&#13;
        return int(stored_version) &gt;= __WELCOME_VERSION&#13;
    except Exception:&#13;
        return False&#13;
&#13;
&#13;
def _mark_welcome_seen():&#13;
    try:&#13;
        QSettings().setValue(__WELCOME_SETTINGS_KEY, __WELCOME_VERSION)&#13;
    except Exception as error:&#13;
        _log_exc("Could not save welcome state", error)&#13;
&#13;
&#13;
def _mark_welcome_unseen():&#13;
    try:&#13;
        QSettings().setValue(__WELCOME_SETTINGS_KEY, 0)&#13;
    except Exception as error:&#13;
        _log_exc("Could not save welcome state", error)&#13;
&#13;
&#13;
def _center_dialog_on_canvas(dialog):&#13;
    try:&#13;
        canvas = iface.mapCanvas()&#13;
        if canvas is None:&#13;
            return&#13;
&#13;
        center = canvas.mapToGlobal(canvas.rect().center())&#13;
        dialog.move(&#13;
            center.x() - dialog.width() // 2,&#13;
            center.y() - dialog.height() // 2,&#13;
        )&#13;
    except Exception:&#13;
        pass&#13;
&#13;
&#13;
def _clear_welcome_dialog_reference(*_args):&#13;
    global __welcome_dialog&#13;
    __welcome_dialog = None&#13;
&#13;
&#13;
def _show_welcome_dialog(force=False):&#13;
    global __welcome_dialog&#13;
&#13;
    if __welcome_dialog is not None:&#13;
        try:&#13;
            __welcome_dialog.show()&#13;
            __welcome_dialog.raise_()&#13;
            __welcome_dialog.activateWindow()&#13;
        except Exception:&#13;
            pass&#13;
        return&#13;
&#13;
    if not force and _welcome_seen():&#13;
        return&#13;
&#13;
    try:&#13;
        lang = _current_language()&#13;
        content = __WELCOME_CONTENT.get(lang, __WELCOME_CONTENT["en"])&#13;
&#13;
        dialog = QDialog(iface.mainWindow())&#13;
        dialog.setObjectName("TorilGISWelcomeDialog")&#13;
        dialog.setWindowTitle(content["title"])&#13;
        dialog.setWindowModality(Qt.WindowModality.WindowModal)&#13;
        dialog.setMinimumSize(640, 470)&#13;
        dialog.resize(740, 560)&#13;
        dialog.setStyleSheet(&#13;
            "QDialog#TorilGISWelcomeDialog { background: #FCF8F2; }"&#13;
            "QLabel { color: #2c2c2c; }"&#13;
            "QCheckBox { color: #2c2c2c; }"&#13;
        )&#13;
&#13;
        layout = QVBoxLayout(dialog)&#13;
        layout.setContentsMargins(24, 22, 24, 18)&#13;
        layout.setSpacing(14)&#13;
&#13;
        title = QLabel(content["title"], dialog)&#13;
        title.setWordWrap(True)&#13;
        title.setStyleSheet(&#13;
            "font-size: 25px; font-weight: 700; color: #3a3a3a; "&#13;
            "padding: 0 0 4px 0;"&#13;
        )&#13;
        layout.addWidget(title)&#13;
&#13;
        intro = QLabel(dialog)&#13;
        intro.setTextFormat(Qt.TextFormat.RichText)&#13;
        intro.setWordWrap(True)&#13;
        intro.setText(content["intro"])&#13;
        intro.setStyleSheet(&#13;
            "font-size: 15px; line-height: 1.45; color: #2c2c2c;"&#13;
        )&#13;
        layout.addWidget(intro)&#13;
&#13;
        patreon_frame = QFrame(dialog)&#13;
        patreon_frame.setObjectName("TorilGISPatreonFrame")&#13;
        patreon_frame.setStyleSheet(&#13;
            "QFrame#TorilGISPatreonFrame {"&#13;
            "  background: #F3E6E2;"&#13;
            "  border: 1px solid #D8B7AE;"&#13;
            "  border-radius: 10px;"&#13;
            "}"&#13;
        )&#13;
        patreon_layout = QVBoxLayout(patreon_frame)&#13;
        patreon_layout.setContentsMargins(18, 16, 18, 16)&#13;
        patreon_layout.setSpacing(9)&#13;
&#13;
        patreon_title = QLabel(content["patreon_title"], patreon_frame)&#13;
        patreon_title.setWordWrap(True)&#13;
        patreon_title.setStyleSheet(&#13;
            "font-size: 19px; font-weight: 700; color: #3a3a3a; border: none;"&#13;
        )&#13;
        patreon_layout.addWidget(patreon_title)&#13;
&#13;
        patreon_text = QLabel(content["patreon_text"], patreon_frame)&#13;
        patreon_text.setWordWrap(True)&#13;
        patreon_text.setStyleSheet(&#13;
            "font-size: 15px; line-height: 1.45; color: #2c2c2c; border: none;"&#13;
        )&#13;
        patreon_layout.addWidget(patreon_text)&#13;
&#13;
        patreon_button = QPushButton(content["patreon_button"], patreon_frame)&#13;
        patreon_button.setCursor(Qt.CursorShape.PointingHandCursor)&#13;
        patreon_button.setMinimumHeight(44)&#13;
        patreon_button.setStyleSheet(&#13;
            "QPushButton {"&#13;
            "  background: #a23e48;"&#13;
            "  color: #ffffff;"&#13;
            "  border: 1px solid #87333c;"&#13;
            "  border-radius: 6px;"&#13;
            "  padding: 9px 18px;"&#13;
            "  font-size: 15px;"&#13;
            "  font-weight: 700;"&#13;
            "}"&#13;
            "QPushButton:hover { background: #b76a2a; border-color: #985722; }"&#13;
            "QPushButton:pressed { background: #87333c; }"&#13;
        )&#13;
        patreon_button.clicked.connect(&#13;
            lambda: _open_external_url(__PATREON_URL)&#13;
        )&#13;
        patreon_layout.addWidget(patreon_button)&#13;
        layout.addWidget(patreon_frame)&#13;
&#13;
        browser = QTextBrowser(dialog)&#13;
        browser.setOpenExternalLinks(True)&#13;
        browser.setFrameShape(QFrame.Shape.NoFrame)&#13;
        browser.setStyleSheet(&#13;
            "QTextBrowser {"&#13;
            "  background: transparent;"&#13;
            "  color: #2c2c2c;"&#13;
            "  font-size: 14px;"&#13;
            "  padding: 0;"&#13;
            "}"&#13;
        )&#13;
        browser.setHtml(&#13;
            "&lt;style&gt;a { color:#b76a2a; font-weight:600; }&lt;/style&gt;"&#13;
            "&lt;div style='font-size:14px; line-height:1.45; color:#2c2c2c;'&gt;"&#13;
            "&lt;p style='font-size:11px; line-height:1.35; color:#2c2c2c;'&gt;"&#13;
            f"{content['legal']}"&#13;
            "&lt;/p&gt;&lt;/div&gt;"&#13;
        )&#13;
        layout.addWidget(browser, 1)&#13;
&#13;
        do_not_show_again = QCheckBox(&#13;
            content["do_not_show_again"], dialog&#13;
        )&#13;
        do_not_show_again.setChecked(_welcome_seen() if force else False)&#13;
        layout.addWidget(do_not_show_again)&#13;
&#13;
        buttons = QDialogButtonBox(&#13;
            QDialogButtonBox.StandardButton.Close,&#13;
            parent=dialog,&#13;
        )&#13;
        close_button = buttons.button(&#13;
            QDialogButtonBox.StandardButton.Close&#13;
        )&#13;
        if close_button is not None:&#13;
            close_button.setText(content["close"])&#13;
        buttons.rejected.connect(dialog.reject)&#13;
        layout.addWidget(buttons)&#13;
&#13;
        def _on_finished(_result):&#13;
            if do_not_show_again.isChecked():&#13;
                _mark_welcome_seen()&#13;
            else:&#13;
                _mark_welcome_unseen()&#13;
            _clear_welcome_dialog_reference()&#13;
&#13;
        dialog.finished.connect(_on_finished)&#13;
        dialog.destroyed.connect(_clear_welcome_dialog_reference)&#13;
&#13;
        __welcome_dialog = dialog&#13;
        dialog.show()&#13;
        dialog.raise_()&#13;
        dialog.activateWindow()&#13;
        QTimer.singleShot(0, lambda: _center_dialog_on_canvas(dialog))&#13;
&#13;
    except Exception as error:&#13;
        _clear_welcome_dialog_reference()&#13;
        _log_exc("Welcome dialog error", error, push=True)&#13;
&#13;
def _show_welcome_dialog_if_needed():&#13;
    _show_welcome_dialog(force=False)&#13;
&#13;
&#13;
def _show_welcome_dialog_from_toolbar():&#13;
    _show_welcome_dialog(force=True)&#13;
&#13;
&#13;
# ---------------- External links ----------------&#13;
def _open_external_url(url):&#13;
    try:&#13;
        opened = QDesktopServices.openUrl(QUrl(url))&#13;
        if not opened:&#13;
            _log(&#13;
                _text()["open_url_error"],&#13;
                level=Qgis.MessageLevel.Warning,&#13;
                push=True,&#13;
                duration=6,&#13;
            )&#13;
    except Exception as error:&#13;
        _log_exc("Open URL error", error, push=True)&#13;
&#13;
&#13;
def _open_documentation():&#13;
    lang = _current_language()&#13;
    _open_external_url(__DOCS_URLS.get(lang, __DOCS_URLS["en"]))&#13;
&#13;
&#13;
def _open_web_map():&#13;
    lang = _current_language()&#13;
    _open_external_url(__WEB_MAP_URLS.get(lang, __WEB_MAP_URLS["en"]))&#13;
&#13;
&#13;
def _feedback_form_url():&#13;
    entry_id = str(__FEEDBACK_FORM_ENTRY_ID).strip()&#13;
    if entry_id.startswith("entry."):&#13;
        entry_id = entry_id[6:]&#13;
&#13;
    if not entry_id:&#13;
        return f"{__FEEDBACK_FORM_BASE_URL}?usp=send_form"&#13;
&#13;
    from urllib.parse import quote_plus&#13;
&#13;
    encoded_value = quote_plus(__FEEDBACK_FORM_CONTEXT)&#13;
    return (&#13;
        f"{__FEEDBACK_FORM_BASE_URL}?usp=pp_url"&#13;
        f"&amp;entry.{entry_id}={encoded_value}"&#13;
    )&#13;
&#13;
&#13;
def _open_feedback_form():&#13;
    _open_external_url(_feedback_form_url())&#13;
&#13;
&#13;
# ---------------- Custom toolbar icons ----------------&#13;
__TOOLBAR_ICON_COLORS = {&#13;
    "docs": "#4F6BED",&#13;
    "web_map": "#1F9D8A",&#13;
    "welcome": "#D97706",&#13;
    "feedback": "#A23E48",&#13;
}&#13;
&#13;
&#13;
def _rounded_pen(color, width):&#13;
    pen = QPen(QColor(color))&#13;
    pen.setWidthF(width)&#13;
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)&#13;
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)&#13;
    return pen&#13;
&#13;
&#13;
def _custom_toolbar_icon(kind):&#13;
    """Create a bright toolbar icon without QGIS theme assets."""&#13;
    size = 48&#13;
    pixmap = QPixmap(size, size)&#13;
    pixmap.fill(Qt.GlobalColor.transparent)&#13;
&#13;
    painter = QPainter(pixmap)&#13;
    painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)&#13;
&#13;
    background = QColor(&#13;
        __TOOLBAR_ICON_COLORS.get(kind, "#4F6BED")&#13;
    )&#13;
    white = QColor("#FFFFFF")&#13;
&#13;
    painter.setPen(Qt.PenStyle.NoPen)&#13;
    painter.setBrush(QBrush(background))&#13;
    painter.drawRoundedRect(QRectF(2, 2, 44, 44), 11, 11)&#13;
&#13;
    if kind == "docs":&#13;
        # Question mark inside a circle.&#13;
        painter.setBrush(Qt.BrushStyle.NoBrush)&#13;
        painter.setPen(_rounded_pen(white, 3.2))&#13;
        painter.drawEllipse(QRectF(10.5, 10.5, 27, 27))&#13;
&#13;
        font = QFont()&#13;
        font.setPixelSize(22)&#13;
        font.setBold(True)&#13;
        painter.setFont(font)&#13;
        painter.setPen(white)&#13;
        painter.drawText(&#13;
            QRectF(10.5, 8.5, 27, 30),&#13;
            Qt.AlignmentFlag.AlignCenter,&#13;
            "?",&#13;
        )&#13;
&#13;
    elif kind == "web_map":&#13;
        # Globe with meridians and parallels.&#13;
        painter.setBrush(Qt.BrushStyle.NoBrush)&#13;
        painter.setPen(_rounded_pen(white, 2.8))&#13;
        painter.drawEllipse(QRectF(9.5, 9.5, 29, 29))&#13;
        painter.drawEllipse(QRectF(17, 9.5, 14, 29))&#13;
        painter.drawEllipse(QRectF(9.5, 17, 29, 14))&#13;
&#13;
    elif kind == "welcome":&#13;
        # Filled home symbol, clearly distinct from folder icons.&#13;
        painter.setPen(Qt.PenStyle.NoPen)&#13;
        painter.setBrush(QBrush(white))&#13;
&#13;
        roof = QPolygonF(&#13;
            [&#13;
                QPointF(7.5, 23),&#13;
                QPointF(24, 8.5),&#13;
                QPointF(40.5, 23),&#13;
                QPointF(37.5, 26.5),&#13;
                QPointF(24, 15),&#13;
                QPointF(10.5, 26.5),&#13;
            ]&#13;
        )&#13;
        painter.drawPolygon(roof)&#13;
        painter.drawRoundedRect(QRectF(12.5, 22, 23, 17.5), 2.5, 2.5)&#13;
&#13;
        painter.setBrush(QBrush(background))&#13;
        painter.drawRoundedRect(QRectF(21, 30, 6, 9.5), 1.2, 1.2)&#13;
&#13;
    elif kind == "feedback":&#13;
        # Comic-style speech bubble.&#13;
        painter.setPen(Qt.PenStyle.NoPen)&#13;
        painter.setBrush(QBrush(white))&#13;
&#13;
        bubble = QPainterPath()&#13;
        bubble.addRoundedRect(QRectF(7.5, 9.5, 33, 23.5), 7, 7)&#13;
        painter.drawPath(bubble)&#13;
&#13;
        tail = QPolygonF(&#13;
            [&#13;
                QPointF(13, 30),&#13;
                QPointF(10.5, 39),&#13;
                QPointF(22, 32.5),&#13;
            ]&#13;
        )&#13;
        painter.drawPolygon(tail)&#13;
&#13;
        painter.setBrush(QBrush(background))&#13;
        for x in (16.5, 24, 31.5):&#13;
            painter.drawEllipse(QRectF(x - 1.8, 20, 3.6, 3.6))&#13;
&#13;
    painter.end()&#13;
    return QIcon(pixmap)&#13;
&#13;
&#13;
def _configure_icon_button(button, icon):&#13;
    button.setAutoRaise(True)&#13;
    button.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonIconOnly)&#13;
    button.setIcon(icon)&#13;
    button.setIconSize(QSize(22, 22))&#13;
    button.setFixedSize(30, 30)&#13;
    button.setStyleSheet(&#13;
        "QToolButton {"&#13;
        "  background: transparent;"&#13;
        "  border: 1px solid transparent;"&#13;
        "  border-radius: 6px;"&#13;
        "  padding: 2px;"&#13;
        "}"&#13;
        "QToolButton:hover {"&#13;
        "  background: #F3E6E2;"&#13;
        "  border-color: #D8B7AE;"&#13;
        "}"&#13;
        "QToolButton:pressed {"&#13;
        "  background: #E8D2CA;"&#13;
        "  border-color: #B76A2A;"&#13;
        "}"&#13;
    )&#13;
&#13;
&#13;
# ---------------- Combo helpers and localization ----------------&#13;
def _set_widget_help(widget, text):&#13;
    """Apply tooltip, status tip, and What's This text consistently."""&#13;
    if widget is None:&#13;
        return&#13;
&#13;
    try:&#13;
        widget.setToolTip(text)&#13;
        widget.setStatusTip(text.replace("\n", " "))&#13;
        widget.setWhatsThis(text)&#13;
        widget.setToolTipDuration(30000)&#13;
        widget.setAttribute(&#13;
            Qt.WidgetAttribute.WA_TransparentForMouseEvents, False&#13;
        )&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    try:&#13;
        view = widget.view()&#13;
        view.setToolTip(text)&#13;
        view.setMouseTracking(True)&#13;
    except Exception:&#13;
        pass&#13;
&#13;
&#13;
def _set_current_data(combo, value):&#13;
    if combo is None:&#13;
        return&#13;
&#13;
    index = combo.findData(value)&#13;
    if index &gt;= 0 and combo.currentIndex() != index:&#13;
        combo.setCurrentIndex(index)&#13;
&#13;
&#13;
def _display_tooltip(lang, profile_id):&#13;
    config = __DISPLAY_PROFILES[profile_id]&#13;
    dpi = float(config["dpi"])&#13;
    scale = float(config["scale"])&#13;
    percent = int(round(__DISPLAY_DPI_BASE / dpi * scale * 100))&#13;
&#13;
    if "public_percent" in config:&#13;
        return _text(lang)["display_size_tooltip"].format(&#13;
            percent=config["public_percent"]&#13;
        )&#13;
&#13;
    return _text(lang)["display_dev_tooltip"].format(&#13;
        dpi=config["dpi"],&#13;
        scale=config["scale"],&#13;
        percent=percent,&#13;
    )&#13;
&#13;
&#13;
def _populate_language_combo(lang):&#13;
    if __lang_combo is None:&#13;
        return&#13;
&#13;
    __lang_combo.blockSignals(True)&#13;
    try:&#13;
        __lang_combo.clear()&#13;
        for value in __LANGS:&#13;
            __lang_combo.addItem(__LANG_LABELS[value], value)&#13;
        _set_current_data(__lang_combo, lang)&#13;
    finally:&#13;
        __lang_combo.blockSignals(False)&#13;
&#13;
&#13;
def _populate_udk_combo(lang, current_value):&#13;
    if __udk_combo is None:&#13;
        return&#13;
&#13;
    __udk_combo.blockSignals(True)&#13;
    try:&#13;
        __udk_combo.clear()&#13;
        captions = _text(lang)["udk"]&#13;
        for value in __UDK_LEVELS:&#13;
            __udk_combo.addItem(captions[value], value)&#13;
        _set_current_data(__udk_combo, current_value)&#13;
    finally:&#13;
        __udk_combo.blockSignals(False)&#13;
&#13;
&#13;
def _populate_edition_combo(lang, current_value):&#13;
    if __ed_combo is None:&#13;
        return&#13;
&#13;
    __ed_combo.blockSignals(True)&#13;
    try:&#13;
        __ed_combo.clear()&#13;
        captions = _text(lang)["edition"]&#13;
        for value in __EDITIONS:&#13;
            __ed_combo.addItem(captions[value], value)&#13;
        _set_current_data(__ed_combo, current_value)&#13;
    finally:&#13;
        __ed_combo.blockSignals(False)&#13;
&#13;
&#13;
def _populate_display_combo(lang, current_profile):&#13;
    if __disp_combo is None:&#13;
        return&#13;
&#13;
    __disp_combo.blockSignals(True)&#13;
    try:&#13;
        __disp_combo.clear()&#13;
&#13;
        if current_profile is None:&#13;
            __disp_combo.addItem(&#13;
                _text(lang)["custom_display"], __DISPLAY_CUSTOM_ID&#13;
            )&#13;
            custom_item = __disp_combo.model().item(0)&#13;
            if custom_item is not None:&#13;
                custom_item.setEnabled(False)&#13;
&#13;
        captions = _text(lang)["display"]&#13;
&#13;
        for profile_id in __DISPLAY_PROFILE_ORDER:&#13;
            if profile_id == __DISPLAY_DEVELOPER_HEADER_ID:&#13;
                index = __disp_combo.count()&#13;
                __disp_combo.addItem(&#13;
                    f"── {_text(lang)['display_developer_header']} ──",&#13;
                    __DISPLAY_DEVELOPER_HEADER_ID,&#13;
                )&#13;
                header_item = __disp_combo.model().item(index)&#13;
                if header_item is not None:&#13;
                    header_item.setEnabled(False)&#13;
                    header_font = header_item.font()&#13;
                    header_font.setBold(True)&#13;
                    header_item.setFont(header_font)&#13;
                continue&#13;
&#13;
            index = __disp_combo.count()&#13;
            __disp_combo.addItem(captions[profile_id], profile_id)&#13;
            __disp_combo.setItemData(&#13;
                index,&#13;
                _display_tooltip(lang, profile_id),&#13;
                Qt.ItemDataRole.ToolTipRole,&#13;
            )&#13;
&#13;
        if current_profile is None:&#13;
            _set_current_data(__disp_combo, __DISPLAY_CUSTOM_ID)&#13;
        else:&#13;
            _set_current_data(__disp_combo, current_profile)&#13;
&#13;
    finally:&#13;
        __disp_combo.blockSignals(False)&#13;
&#13;
&#13;
def _sync_display_combo():&#13;
    if __disp_combo is None:&#13;
        return&#13;
&#13;
    dpi, scale = _display_values()&#13;
    profile = _detect_display_profile(dpi, scale)&#13;
    _populate_display_combo(_current_language(), profile)&#13;
&#13;
&#13;
def _populate_measure_combo(lang, current_system):&#13;
    if __measure_combo is None:&#13;
        return&#13;
&#13;
    __measure_combo.blockSignals(True)&#13;
    try:&#13;
        __measure_combo.clear()&#13;
        captions = _text(lang)["measure"]&#13;
        for system in __MEASURE_SYSTEMS:&#13;
            __measure_combo.addItem(captions[system], system)&#13;
        _set_current_data(__measure_combo, current_system)&#13;
        _set_widget_help(__measure_combo, _text(lang)["measure_tooltip"])&#13;
    finally:&#13;
        __measure_combo.blockSignals(False)&#13;
&#13;
&#13;
def _sync_measure_combo(lang=None):&#13;
    if __measure_combo is None:&#13;
        return&#13;
&#13;
    if lang not in __LANGS:&#13;
        lang = _current_language()&#13;
&#13;
    _populate_measure_combo(lang, _current_measure_system())&#13;
&#13;
&#13;
def _retranslate_toolbar(lang):&#13;
    global __ui_lang&#13;
&#13;
    if lang not in __LANGS:&#13;
        lang = "en"&#13;
&#13;
    project_scope = QgsExpressionContextUtils.projectScope(QgsProject.instance())&#13;
    current_udk = project_scope.variable("TG_CONFIG_UDK_LEVEL")&#13;
    current_edition = project_scope.variable("TG_CONFIG_DND_EDITION")&#13;
    dpi, scale = _display_values()&#13;
    current_profile = _detect_display_profile(dpi, scale)&#13;
&#13;
    texts = _text(lang)&#13;
&#13;
    if __lbl_udk is not None:&#13;
        __lbl_udk.setText(texts["label_udk"])&#13;
    if __lbl_ed is not None:&#13;
        __lbl_ed.setText(texts["label_edition"])&#13;
    if __lbl_disp is not None:&#13;
        __lbl_disp.setText(texts["label_display"])&#13;
    if __lbl_measure is not None:&#13;
        __lbl_measure.setText(texts["label_measure"])&#13;
&#13;
    # Every toolbar control has a localized tooltip. Labels repeat the&#13;
    # associated control tooltip so the description is available across&#13;
    # the whole control group.&#13;
    for widget in (__lbl_udk, __udk_combo):&#13;
        _set_widget_help(widget, texts["udk_tooltip"])&#13;
    for widget in (__lbl_ed, __ed_combo):&#13;
        _set_widget_help(widget, texts["edition_tooltip"])&#13;
    for widget in (__lbl_disp, __disp_combo):&#13;
        _set_widget_help(widget, texts["display_tooltip"])&#13;
    for widget in (__lbl_measure, __measure_combo):&#13;
        _set_widget_help(widget, texts["measure_tooltip"])&#13;
&#13;
    _populate_language_combo(lang)&#13;
    _populate_udk_combo(lang, current_udk)&#13;
    _populate_edition_combo(lang, current_edition)&#13;
    _populate_display_combo(lang, current_profile)&#13;
    _populate_measure_combo(lang, _current_measure_system())&#13;
&#13;
    if __lang_combo is not None:&#13;
        _set_widget_help(__lang_combo, texts["language_tooltip"])&#13;
&#13;
    if __search_combo is not None:&#13;
        line_edit = __search_combo.lineEdit()&#13;
        if line_edit is not None:&#13;
            line_edit.setPlaceholderText(texts["search_placeholder"])&#13;
            _set_widget_help(line_edit, texts["search_tooltip"])&#13;
        _set_widget_help(__search_combo, texts["search_tooltip"])&#13;
&#13;
&#13;
    if __docs_button is not None:&#13;
        _set_widget_help(__docs_button, texts["button_docs_tooltip"])&#13;
        __docs_button.setAccessibleName(texts["button_docs"])&#13;
&#13;
    if __web_map_button is not None:&#13;
        _set_widget_help(__web_map_button, texts["button_web_map_tooltip"])&#13;
        __web_map_button.setAccessibleName(texts["button_web_map"])&#13;
&#13;
    if __welcome_button is not None:&#13;
        _set_widget_help(__welcome_button, texts["button_welcome_tooltip"])&#13;
        __welcome_button.setAccessibleName(texts["button_welcome"])&#13;
&#13;
    if __feedback_button is not None:&#13;
        _set_widget_help(__feedback_button, texts["button_feedback_tooltip"])&#13;
        __feedback_button.setAccessibleName(texts["button_feedback"])&#13;
&#13;
    __ui_lang = lang&#13;
&#13;
    # Existing result labels belong to the previous language.&#13;
    if __search_last_query.strip():&#13;
        _schedule_search(__search_last_query)&#13;
    else:&#13;
        _clear_search_results()&#13;
&#13;
&#13;
# ---------------- Toolbar signal handlers ----------------&#13;
def _on_lang_changed(_index):&#13;
    if __lang_combo is None:&#13;
        return&#13;
    _apply_lang(__lang_combo.currentData())&#13;
&#13;
&#13;
def _on_udk_changed(_index):&#13;
    if __udk_combo is None:&#13;
        return&#13;
    _apply_udk(__udk_combo.currentData())&#13;
&#13;
&#13;
def _on_edition_changed(_index):&#13;
    if __ed_combo is None:&#13;
        return&#13;
    _apply_edition(__ed_combo.currentData())&#13;
&#13;
&#13;
def _on_display_changed(_index):&#13;
    if __disp_combo is None:&#13;
        return&#13;
    _apply_display(__disp_combo.currentData())&#13;
&#13;
&#13;
def _on_measure_changed(_index):&#13;
    if __measure_combo is None:&#13;
        return&#13;
    _apply_measure_system(__measure_combo.currentData())&#13;
&#13;
&#13;
# ---------------- Search helpers ----------------&#13;
def _is_null(value):&#13;
    if value is None:&#13;
        return True&#13;
&#13;
    try:&#13;
        return QgsVariantUtils.isNull(value)&#13;
    except Exception:&#13;
        return False&#13;
&#13;
&#13;
def _value_to_search_text(value):&#13;
    if _is_null(value):&#13;
        return ""&#13;
&#13;
    if isinstance(value, (list, tuple, set)):&#13;
        return " | ".join(&#13;
            str(item) for item in value if not _is_null(item)&#13;
        )&#13;
&#13;
    return str(value)&#13;
&#13;
&#13;
def _feature_attribute(feature, field_name):&#13;
    if not field_name:&#13;
        return ""&#13;
&#13;
    try:&#13;
        return _value_to_search_text(feature[field_name])&#13;
    except Exception:&#13;
        return ""&#13;
&#13;
&#13;
def _search_field_names(lang):&#13;
    return (&#13;
        f"name_{lang}",&#13;
        f"descr_{lang}",&#13;
        f"name_alt_{lang}",&#13;
    )&#13;
&#13;
&#13;
def _search_rank(primary_name, alternative_names, description, needle):&#13;
    primary = primary_name.strip().casefold()&#13;
    alternatives = alternative_names.casefold()&#13;
    descr = description.casefold()&#13;
&#13;
    if primary == needle:&#13;
        return 0&#13;
    if primary.startswith(needle):&#13;
        return 1&#13;
    if needle in primary:&#13;
        return 2&#13;
    if needle in alternatives:&#13;
        return 3&#13;
    if needle in descr:&#13;
        return 4&#13;
&#13;
    return None&#13;
&#13;
&#13;
def _build_search_filter(existing_fields, needle):&#13;
    quoted_needle = QgsExpression.quotedString(needle.lower())&#13;
    parts = []&#13;
&#13;
    for field_name in existing_fields:&#13;
        column = QgsExpression.quotedColumnRef(field_name)&#13;
        parts.append(&#13;
            "strpos("&#13;
            f"lower(coalesce(to_string({column}), '')), "&#13;
            f"{quoted_needle}"&#13;
            ") &gt; 0"&#13;
        )&#13;
&#13;
    return " OR ".join(parts)&#13;
&#13;
&#13;
def _collect_search_results(query):&#13;
    lang = _current_language()&#13;
    name_field, descr_field, alt_field = _search_field_names(lang)&#13;
    needle = query.strip().casefold()&#13;
    results = []&#13;
&#13;
    for layer in QgsProject.instance().mapLayers().values():&#13;
        if not isinstance(layer, QgsVectorLayer):&#13;
            continue&#13;
        if not layer.isValid():&#13;
            continue&#13;
        if layer.name().strip().casefold() in __SEARCH_EXCLUDED_LAYER_NAMES:&#13;
            continue&#13;
&#13;
        fields = layer.fields()&#13;
        existing_search_fields = [&#13;
            field_name&#13;
            for field_name in (name_field, descr_field, alt_field)&#13;
            if fields.indexOf(field_name) &gt;= 0&#13;
        ]&#13;
&#13;
        if not existing_search_fields:&#13;
            continue&#13;
&#13;
        fallback_name_field = None&#13;
        if name_field != "name_en" and fields.indexOf("name_en") &gt;= 0:&#13;
            fallback_name_field = "name_en"&#13;
&#13;
        subset_fields = list(existing_search_fields)&#13;
        if fallback_name_field and fallback_name_field not in subset_fields:&#13;
            subset_fields.append(fallback_name_field)&#13;
&#13;
        subset_indexes = [fields.indexOf(name) for name in subset_fields]&#13;
&#13;
        request = QgsFeatureRequest()&#13;
        request.setFlags(Qgis.FeatureRequestFlag.NoGeometry)&#13;
        request.setSubsetOfAttributes(subset_indexes)&#13;
        request.setLimit(__SEARCH_CANDIDATES_PER_LAYER)&#13;
&#13;
        filter_expression = _build_search_filter(&#13;
            existing_search_fields, needle&#13;
        )&#13;
        if filter_expression:&#13;
            request.setFilterExpression(filter_expression)&#13;
&#13;
        try:&#13;
            features = layer.getFeatures(request)&#13;
&#13;
            for feature in features:&#13;
                primary_name = _feature_attribute(feature, name_field)&#13;
                alternative_names = _feature_attribute(feature, alt_field)&#13;
                description = _feature_attribute(feature, descr_field)&#13;
&#13;
                rank = _search_rank(&#13;
                    primary_name,&#13;
                    alternative_names,&#13;
                    description,&#13;
                    needle,&#13;
                )&#13;
                if rank is None:&#13;
                    continue&#13;
&#13;
                display_name = primary_name.strip()&#13;
                if not display_name and fallback_name_field:&#13;
                    display_name = _feature_attribute(&#13;
                        feature, fallback_name_field&#13;
                    ).strip()&#13;
                if not display_name:&#13;
                    display_name = _text(lang)["search_unnamed"]&#13;
&#13;
                results.append(&#13;
                    {&#13;
                        "rank": rank,&#13;
                        "name": display_name,&#13;
                        "layer_name": layer.name(),&#13;
                        "layer_id": layer.id(),&#13;
                        "feature_id": int(feature.id()),&#13;
                    }&#13;
                )&#13;
&#13;
        except Exception as error:&#13;
            _log_exc(f"Search failed for layer '{layer.name()}'", error)&#13;
&#13;
    results.sort(&#13;
        key=lambda item: (&#13;
            item["rank"],&#13;
            item["name"].casefold(),&#13;
            item["layer_name"].casefold(),&#13;
        )&#13;
    )&#13;
&#13;
    return results[:__SEARCH_RESULT_LIMIT]&#13;
&#13;
&#13;
def _clear_search_results():&#13;
    if __search_combo is None:&#13;
        return&#13;
&#13;
    line_edit = __search_combo.lineEdit()&#13;
    current_text = line_edit.text() if line_edit is not None else ""&#13;
    cursor_position = (&#13;
        line_edit.cursorPosition() if line_edit is not None else len(current_text)&#13;
    )&#13;
&#13;
    __search_combo.blockSignals(True)&#13;
    try:&#13;
        __search_combo.clear()&#13;
        __search_combo.setCurrentIndex(-1)&#13;
        __search_combo.setEditText(current_text)&#13;
        if line_edit is not None:&#13;
            line_edit.setCursorPosition(&#13;
                min(cursor_position, len(current_text))&#13;
            )&#13;
    finally:&#13;
        __search_combo.blockSignals(False)&#13;
&#13;
&#13;
def _populate_search_results(query, results):&#13;
    if __search_combo is None:&#13;
        return&#13;
&#13;
    line_edit = __search_combo.lineEdit()&#13;
    cursor_position = (&#13;
        line_edit.cursorPosition() if line_edit is not None else len(query)&#13;
    )&#13;
&#13;
    __search_combo.blockSignals(True)&#13;
    try:&#13;
        __search_combo.clear()&#13;
&#13;
        if results:&#13;
            for result in results:&#13;
                caption = f"{result['name']} - {result['layer_name']}"&#13;
                __search_combo.addItem(caption, result)&#13;
        else:&#13;
            __search_combo.addItem(&#13;
                _text()["search_no_results"], None&#13;
            )&#13;
            item = __search_combo.model().item(0)&#13;
            if item is not None:&#13;
                item.setEnabled(False)&#13;
&#13;
        __search_combo.setCurrentIndex(-1)&#13;
        __search_combo.setEditText(query)&#13;
&#13;
        if line_edit is not None:&#13;
            line_edit.setCursorPosition(min(cursor_position, len(query)))&#13;
&#13;
    finally:&#13;
        __search_combo.blockSignals(False)&#13;
&#13;
    if results and line_edit is not None and line_edit.hasFocus():&#13;
        QTimer.singleShot(0, __search_combo.showPopup)&#13;
&#13;
&#13;
def _schedule_search(query=None):&#13;
    global __search_revision, __search_last_query&#13;
&#13;
    if __search_combo is None:&#13;
        return&#13;
&#13;
    if query is None:&#13;
        line_edit = __search_combo.lineEdit()&#13;
        query = line_edit.text() if line_edit is not None else ""&#13;
&#13;
    __search_last_query = query&#13;
    __search_revision += 1&#13;
    revision = __search_revision&#13;
&#13;
    def _run_if_current():&#13;
        if revision != __search_revision:&#13;
            return&#13;
        _run_search(query, revision)&#13;
&#13;
    QTimer.singleShot(__SEARCH_DELAY_MS, _run_if_current)&#13;
&#13;
&#13;
def _run_search(query, revision):&#13;
    if revision != __search_revision or __search_combo is None:&#13;
        return&#13;
&#13;
    normalized = query.strip()&#13;
    if len(normalized) &lt; __SEARCH_MIN_CHARS:&#13;
        _clear_search_results()&#13;
        return&#13;
&#13;
    try:&#13;
        results = _collect_search_results(normalized)&#13;
        if revision != __search_revision:&#13;
            return&#13;
        _populate_search_results(query, results)&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Search error", error, push=True)&#13;
&#13;
&#13;
def _on_search_text_edited(text):&#13;
    _schedule_search(text)&#13;
&#13;
&#13;
def _clear_previous_search_selection():&#13;
    global __search_selected_layer_id, __search_selected_feature_id&#13;
&#13;
    if (&#13;
        __search_selected_layer_id is None&#13;
        or __search_selected_feature_id is None&#13;
    ):&#13;
        return&#13;
&#13;
    try:&#13;
        layer = QgsProject.instance().mapLayer(__search_selected_layer_id)&#13;
        if isinstance(layer, QgsVectorLayer):&#13;
            layer.deselect([__search_selected_feature_id])&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    __search_selected_layer_id = None&#13;
    __search_selected_feature_id = None&#13;
&#13;
&#13;
def _zoom_to_search_result(result):&#13;
    global __search_selected_layer_id, __search_selected_feature_id&#13;
&#13;
    if not result:&#13;
        return&#13;
&#13;
    layer = QgsProject.instance().mapLayer(result.get("layer_id"))&#13;
    if not isinstance(layer, QgsVectorLayer) or not layer.isValid():&#13;
        return&#13;
&#13;
    feature_id = result.get("feature_id")&#13;
    if feature_id is None:&#13;
        return&#13;
&#13;
    _clear_previous_search_selection()&#13;
&#13;
    try:&#13;
        layer.selectByIds([feature_id])&#13;
        iface.setActiveLayer(layer)&#13;
        iface.mapCanvas().zoomToSelected(layer)&#13;
&#13;
        try:&#13;
            iface.mapCanvas().flashFeatureIds(layer, [feature_id])&#13;
        except Exception:&#13;
            pass&#13;
&#13;
        __search_selected_layer_id = layer.id()&#13;
        __search_selected_feature_id = feature_id&#13;
&#13;
    except Exception as error:&#13;
        _log_exc("Zoom to search result failed", error, push=True)&#13;
&#13;
&#13;
def _on_search_result_activated(index):&#13;
    if __search_combo is None or index &lt; 0:&#13;
        return&#13;
&#13;
    result = __search_combo.itemData(index)&#13;
    if not result:&#13;
        return&#13;
&#13;
    _zoom_to_search_result(result)&#13;
&#13;
    # Keep the original query in the editable field.&#13;
    __search_combo.blockSignals(True)&#13;
    try:&#13;
        __search_combo.setCurrentIndex(-1)&#13;
        __search_combo.setEditText(__search_last_query)&#13;
    finally:&#13;
        __search_combo.blockSignals(False)&#13;
&#13;
&#13;
# ---------------- Variable synchronization ----------------&#13;
def _sync_from_vars():&#13;
    project_scope = QgsExpressionContextUtils.projectScope(QgsProject.instance())&#13;
&#13;
    current_lang = project_scope.variable("TG_CONFIG_LANG")&#13;
    current_udk = project_scope.variable("TG_CONFIG_UDK_LEVEL")&#13;
    current_edition = project_scope.variable("TG_CONFIG_DND_EDITION")&#13;
    current_measure_system = project_scope.variable("TG_CONFIG_MEASURE_SYSTEM")&#13;
&#13;
    if current_lang not in __LANGS:&#13;
        current_lang = "en"&#13;
    if current_udk not in __UDK_LEVELS:&#13;
        current_udk = "All"&#13;
    if current_edition not in __EDITIONS:&#13;
        current_edition = "All"&#13;
    if current_measure_system not in __MEASURE_SYSTEMS:&#13;
        current_measure_system = "metric"&#13;
&#13;
    # TG_CONFIG_MEASURE_SYSTEM is a custom project variable, while&#13;
    # distance and area units are native QgsProject settings.&#13;
    if not _measure_units_match(current_measure_system):&#13;
        _set_project_measure_units(current_measure_system)&#13;
&#13;
    if __ui_lang != current_lang:&#13;
        _retranslate_toolbar(current_lang)&#13;
    else:&#13;
        if __lang_combo is not None:&#13;
            __lang_combo.blockSignals(True)&#13;
            try:&#13;
                _set_current_data(__lang_combo, current_lang)&#13;
            finally:&#13;
                __lang_combo.blockSignals(False)&#13;
&#13;
        if __udk_combo is not None:&#13;
            __udk_combo.blockSignals(True)&#13;
            try:&#13;
                _set_current_data(__udk_combo, current_udk)&#13;
            finally:&#13;
                __udk_combo.blockSignals(False)&#13;
&#13;
        if __ed_combo is not None:&#13;
            __ed_combo.blockSignals(True)&#13;
            try:&#13;
                _set_current_data(__ed_combo, current_edition)&#13;
            finally:&#13;
                __ed_combo.blockSignals(False)&#13;
&#13;
        _sync_display_combo()&#13;
        _sync_measure_combo(current_lang)&#13;
&#13;
&#13;
# ---------------- Toolbar construction ----------------&#13;
def _build_toolbar():&#13;
    global __tg_toolbar&#13;
    global __lbl_udk, __lbl_ed, __lbl_disp, __lbl_measure&#13;
    global __lang_combo, __udk_combo, __ed_combo, __disp_combo&#13;
    global __search_combo, __measure_combo&#13;
    global __docs_button, __web_map_button, __welcome_button, __feedback_button&#13;
&#13;
    if __tg_toolbar is not None:&#13;
        try:&#13;
            __tg_toolbar.show()&#13;
            __tg_toolbar.setVisible(True)&#13;
        except Exception:&#13;
            pass&#13;
        return __tg_toolbar&#13;
&#13;
    main_window = iface.mainWindow()&#13;
    if main_window is None:&#13;
        raise RuntimeError("iface.mainWindow() returned None")&#13;
&#13;
    # Remove an orphaned toolbar left by a previous macro reload.&#13;
    try:&#13;
        old_toolbar = main_window.findChild(QToolBar, "TorilGISControls")&#13;
        if old_toolbar is not None:&#13;
            main_window.removeToolBar(old_toolbar)&#13;
            old_toolbar.deleteLater()&#13;
    except Exception:&#13;
        pass&#13;
&#13;
    toolbar = QToolBar("Toril GIS")&#13;
    toolbar.setObjectName("TorilGISControls")&#13;
    toolbar.setMovable(True)&#13;
    toolbar.setFloatable(True)&#13;
    toolbar.setVisible(True)&#13;
&#13;
    container = QWidget()&#13;
    layout = QHBoxLayout(container)&#13;
    layout.setContentsMargins(6, 0, 6, 0)&#13;
    layout.setSpacing(6)&#13;
&#13;
    # Language has no visible label: the selected language name is sufficient.&#13;
    lang_combo = QComboBox()&#13;
    lang_combo.setMinimumWidth(88)&#13;
    lang_combo.setMaximumWidth(104)&#13;
&#13;
    label_udk = QLabel()&#13;
    label_udk.setAlignment(&#13;
        Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft&#13;
    )&#13;
    udk_combo = QComboBox()&#13;
    udk_combo.setMinimumWidth(112)&#13;
    udk_combo.setMaximumWidth(142)&#13;
&#13;
    label_ed = QLabel()&#13;
    label_ed.setAlignment(&#13;
        Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft&#13;
    )&#13;
    edition_combo = QComboBox()&#13;
    edition_combo.setMinimumWidth(58)&#13;
    edition_combo.setMaximumWidth(68)&#13;
&#13;
    label_disp = QLabel()&#13;
    label_disp.setAlignment(&#13;
        Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft&#13;
    )&#13;
    display_combo = QComboBox()&#13;
    display_combo.setMinimumWidth(88)&#13;
    display_combo.setMaximumWidth(118)&#13;
&#13;
    label_measure = QLabel()&#13;
    label_measure.setAlignment(&#13;
        Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft&#13;
    )&#13;
    measure_combo = QComboBox()&#13;
    measure_combo.setMinimumWidth(92)&#13;
    measure_combo.setMaximumWidth(116)&#13;
&#13;
    search_combo = QComboBox()&#13;
    search_combo.setEditable(True)&#13;
    search_combo.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)&#13;
    search_combo.setMaxVisibleItems(18)&#13;
    search_combo.setMinimumWidth(220)&#13;
    search_combo.setMaximumWidth(360)&#13;
    search_combo.setCurrentIndex(-1)&#13;
&#13;
    line_edit = search_combo.lineEdit()&#13;
    if line_edit is not None:&#13;
        line_edit.setClearButtonEnabled(True)&#13;
&#13;
    docs_button = QToolButton()&#13;
    _configure_icon_button(&#13;
        docs_button,&#13;
