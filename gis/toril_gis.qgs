    "size_100",&#13;
    "size_110",&#13;
    "size_125",&#13;
    "size_150",&#13;
    __DISPLAY_DEVELOPER_HEADER_ID,&#13;
    "dev_dell",&#13;
    "dev_tuxedo",&#13;
    "dev_macbook_pro_2013",&#13;
)&#13;
&#13;
