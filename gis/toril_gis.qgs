&#13;
__DISPLAY_DPI_BASE = 94.0&#13;
__DISPLAY_CUSTOM_ID = "__custom__"&#13;
__DISPLAY_DEVELOPER_HEADER_ID = "__developer_header__"&#13;
&#13;
# Display values are stored in QGIS global/user scope, not project scope.&#13;
# The coefficient used by the project is:&#13;
# @tg_display_dpi_base / @TG_CONFIG_DISPLAY_DPI * @TG_CONFIG_DISPLAY_SCALE&#13;
__DISPLAY_PROFILES = {&#13;
    # Public presets expose only the resulting label/marker size.&#13;
    # With dpi equal to the base DPI, scale is the final coefficient.&#13;
    "size_75": {"dpi": "94", "scale": "0.75", "public_percent": 75},&#13;
    "size_90": {"dpi": "94", "scale": "0.90", "public_percent": 90},&#13;
    "size_100": {"dpi": "94", "scale": "1.00", "public_percent": 100},&#13;
    "size_110": {"dpi": "94", "scale": "1.10", "public_percent": 110},&#13;
    "size_125": {"dpi": "94", "scale": "1.25", "public_percent": 125},&#13;
    "size_150": {"dpi": "94", "scale": "1.50", "public_percent": 150},&#13;
&#13;
    # Exact developer values must remain unchanged.&#13;
    "dev_dell": {"dpi": "92", "scale": "1.0"},&#13;
    "dev_tuxedo": {"dpi": "243", "scale": "2.0"},&#13;
    "dev_macbook_pro_2013": {"dpi": "220", "scale": "2.4"},&#13;
}&#13;
&#13;
