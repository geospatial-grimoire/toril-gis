      <properties name="Label" type="QString">[%CONCAT(
    'zoom ', ROUND(@vector_tile_zoom, 2), 
    '\nscale 1:', FORMAT_NUMBER(@map_scale, 0, 'ru'), 
    '\nlat ', 
    TO_DMS(Y(TRANSFORM(@map_extent_center, @map_crs, 'USER:100029')), 'y', 0), 
    ' lon ', 
    TO_DMS(X(TRANSFORM(@map_extent_center, @map_crs, 'USER:100029')), 'x', 0),
	'\ndisplay ', @TG_CONFIG_DISPLAY_DPI, 'DPI ',
	@TG_CONFIG_DISPLAY_SCALE * 100, '%'
)%]</properties>
      <properties name="MarginH" type="int">10</properties>
      <properties name="MarginUnit" type="QString">Pixel</properties>
      <properties name="MarginV" type="int">4</properties>
      <properties name="Placement" type="int">3</properties>
    </properties>
    <properties name="Variables">
      <properties name="variableNames" type="QStringList">
        <value>TG_CONFIG_DND_EDITION</value>
        <value>TG_CONFIG_FONT_1_1</value>
        <value>TG_CONFIG_FONT_1_2</value>
        <value>TG_CONFIG_FONT_1_3</value>
        <value>TG_CONFIG_FONT_2_1</value>
        <value>TG_CONFIG_FONT_2_2</value>
        <value>TG_CONFIG_FONT_2_3</value>
        <value>TG_CONFIG_FONT_BASE_SIZE</value>
        <value>TG_CONFIG_LABEL_ABB_LIMIT</value>
        <value>TG_CONFIG_LABEL_WRAP_LIMIT</value>
        <value>TG_CONFIG_LANG</value>
        <value>TG_CONFIG_MEASURE_SYSTEM</value>
        <value>TG_CONFIG_STROKE_BASE_WIDTH</value>
        <value>TG_CONFIG_SYMBOL_BASE_SIZE</value>
        <value>TG_CONFIG_UDK_LEVEL</value>
        <value>tg_data_label</value>
        <value>tg_data_label_abb</value>
        <value>tg_display_dpi_base</value>
        <value>tg_f_display_scale_coefficient</value>
        <value>tg_f_feature_alpha</value>
        <value>tg_f_feature_visibility</value>
        <value>tg_f_font_type_case</value>
        <value>tg_f_generate_layer_id</value>
        <value>tg_f_label</value>
        <value>tg_f_label_abb</value>
        <value>tg_f_label_buffer_size</value>
        <value>tg_f_label_color</value>
        <value>tg_f_label_size</value>
        <value>tg_f_label_visibility</value>
        <value>tg_f_label_visibility_river</value>
        <value>tg_f_measure_area_unit</value>
        <value>tg_f_measure_length_unit</value>
        <value>tg_f_stroke_min_width</value>
        <value>tg_f_symbol_min_size</value>
        <value>tg_f_te_auto_link</value>
        <value>tg_f_wiki_auto_link</value>
      </properties>
      <properties name="variableValues" type="QStringList">
        <value>All</value>
        <value>Alegreya Sans</value>
        <value>Alegreya</value>
        <value>Fira Code</value>
        <value>Noto Serif</value>
        <value>Noto Serif</value>
        <value>Noto Serif</value>
        <value>10</value>
        <value>10</value>
        <value>12</value>
        <value>en</value>
        <value>imperial</value>
        <value>0.8</value>
        <value>5</value>
        <value>All</value>
        <value>'name_' || @TG_CONFIG_LANG</value>
        <value>'name_abb_' || @TG_CONFIG_LANG</value>
        <value>94</value>
        <value>(@tg_display_dpi_base / @TG_CONFIG_DISPLAY_DPI * @TG_CONFIG_DISPLAY_SCALE)</value>
        <value>CASE&#13;
  WHEN left("layer_id", 4) != 'udk_' THEN 100&#13;
  WHEN @TG_CONFIG_UDK_LEVEL = 'All' THEN 100&#13;
  WHEN array_contains("feature_levels", @TG_CONFIG_UDK_LEVEL) THEN 100&#13;
  ELSE 25&#13;
END</value>
        <value>"is_visible"
AND (
    @TG_CONFIG_DND_EDITION = 'All'
    OR "dnd_editions" IS NULL
    OR array_contains("dnd_editions", @TG_CONFIG_DND_EDITION)
)</value>
        <value>CASE
    WHEN "feature_class" IN ('')
    THEN 'Upper'
    ELSE 'NoChange'
END</value>
        <value>with_variable(
  'level_abbr',
  -- Part 1: Determine level abbreviation from the "layer_level" field
  CASE
    WHEN lower("layer_level") = 'global' THEN 'glb'
    WHEN lower("layer_level") = 'surface' THEN 'srf'
    WHEN lower("layer_level") = 'underdark' THEN 'udk'
    WHEN lower("layer_level") = 'underwater' THEN 'udw'
  END,
  with_variable(
    'theme_abbr',
    -- Part 2: Determine theme abbreviation from the "layer_theme" field
    CASE
      WHEN lower("layer_theme") = 'civilized' THEN 'civ'
      WHEN lower("layer_theme") = 'natural' THEN 'nat'
      WHEN lower("layer_theme") = 'conceptual' THEN 'con'
    END,
    with_variable(
      'clean_name',
      -- Part 3: Sanitize the layer name from the "layer_name" field
      regexp_replace(
        regexp_replace(lower(replace("layer_name", '-', ' ')), '\\s+', '_'),
        '[^a-z0-9_]',
        ''
      ),
      with_variable(
        'geom_type_abbr',
        -- Part 4: Determine geometry type abbreviation from the feature's geometry
        CASE
          -- Note: geometry_type() returns 'Line' for linestrings
          WHEN geometry_type($geometry) IN ('Polygon', 'MultiPolygon') THEN 'pg'
          WHEN geometry_type($geometry) IN ('Point', 'MultiPoint') THEN 'pt'
          WHEN geometry_type($geometry) IN ('Line', 'MultiLineString') THEN 'ln'
        END,
        -- Final Step: Concatenate all parts with underscores
        @level_abbr || '_' || @theme_abbr || '_' || @clean_name || '_' || @geom_type_abbr
      )
    )
  )
)</value>
        <value>COALESCE(
    NULLIF(ATTRIBUTE(eval(@tg_data_label)), ''),
    NULLIF(ATTRIBUTE('name_en'), '')
)</value>
        <value>with_variable('lim', to_int(@TG_CONFIG_LABEL_ABB_LIMIT),
with_variable('lbl', attribute(eval(@tg_data_label)),
with_variable('abb', NULLIF(attribute(eval(@tg_data_label_abb)), ''),
  if(length(@lbl) &lt;= @lim, @lbl, coalesce(@abb, @lbl))
)))</value>
        <value>TO_INT(EVAL(@tg_f_label_size)) / 4</value>
        <value>CASE 
    WHEN layer_property(@layer, 'title') LIKE 'srf_civ%' 
    THEN project_color('label/civ')

    WHEN layer_property(@layer, 'title') LIKE 'srf_con%' 
         OR layer_property(@layer, 'title') LIKE 'glb_con%' 
    THEN project_color('label/con')

    WHEN layer_property(@layer, 'title') LIKE 'srf_nat%' 
    THEN project_color(
        CASE 
            WHEN attribute('feature_class') LIKE 'Water/%' 
            THEN 'water/stroke'
            ELSE 'label/nat'
        END
    )

    ELSE project_color('label/civ')
END</value>
        <value>CASE WHEN attribute('feature_rank') &lt; 5 THEN (@TG_CONFIG_FONT_BASE_SIZE  - attribute('feature_rank')) * 2 * eval(@tg_f_display_scale_coefficient) ELSE @TG_CONFIG_FONT_BASE_SIZE * eval(@tg_f_display_scale_coefficient) END</value>
        <value>eval(@tg_f_feature_visibility)
AND "is_labeled"
AND "feature_rank" &lt; @vector_tile_zoom
AND "name_en" NOT LIKE 'unnamed'</value>
        <value>eval(@tg_f_feature_visibility) AND "is_labeled" AND "feature_rank" &lt; @vector_tile_zoom</value>
        <value>CASE
    WHEN @TG_CONFIG_MEASURE_SYSTEM = 'metric'
    THEN 'km²'
    WHEN @TG_CONFIG_MEASURE_SYSTEM = 'imperial'
    THEN 'mi²'
    ELSE NULL
END</value>
        <value>CASE
    WHEN @TG_CONFIG_MEASURE_SYSTEM = 'metric'
    THEN 'km'
    WHEN @TG_CONFIG_MEASURE_SYSTEM = 'imperial'
    THEN 'mi'
    ELSE NULL
END</value>
        <value>@TG_CONFIG_STROKE_BASE_WIDTH * eval(@tg_f_display_scale_coefficient)</value>
        <value>@TG_CONFIG_SYMBOL_BASE_SIZE * eval(@tg_f_display_scale_coefficient)</value>
        <value>CASE 
    WHEN "uuid" IS NOT NULL 
    THEN 'https://te.geospatial-grimoire.com/?uuid=' || "uuid"
    ELSE NULL 
END</value>
        <value>CASE 
    WHEN NULLIF("name_en", '') IS NOT NULL 
    THEN 'https://forgottenrealms.fandom.com/wiki/' ||
         replace(
         replace(
         replace(
         replace(
         replace(
         replace(
         replace(
         replace("name_en", ' ', '_'),
         '''', '%27'),
         ',', '%2C'),
         ';', '%3B'),
         ':', '%3A'),
         '"', '%22'),
         '(', '%28'),
         ')', '%29')
    ELSE NULL 
END</value>
      </properties>
    </properties>
