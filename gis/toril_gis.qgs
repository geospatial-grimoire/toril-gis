    <properties name="Macros">
      <properties name="pythonCode" type="QString"># ================================================================&#13;
# Toril GIS Project Macros for QGIS 4&#13;
# Localized toolbar, search, measurement settings, custom icons, links, and branded welcome dialog&#13;
# ================================================================&#13;
&#13;
from qgis.PyQt.QtWidgets import (&#13;
    QToolBar,&#13;
    QComboBox,&#13;
    QLabel,&#13;
    QToolButton,&#13;
    QWidget,&#13;
    QHBoxLayout,&#13;
    QVBoxLayout,&#13;
    QDialog,&#13;
    QDialogButtonBox,&#13;
    QTextBrowser,&#13;
    QCheckBox,&#13;
    QPushButton,&#13;
    QFrame,&#13;
)&#13;
from qgis.PyQt.QtCore import (&#13;
    Qt,&#13;
    QTimer,&#13;
    QUrl,&#13;
    QSettings,&#13;
    QSize,&#13;
    QRectF,&#13;
    QPointF,&#13;
)&#13;
from qgis.PyQt.QtGui import (&#13;
    QDesktopServices,&#13;
    QIcon,&#13;
    QPixmap,&#13;
    QPainter,&#13;
    QColor,&#13;
    QPen,&#13;
    QBrush,&#13;
    QFont,&#13;
    QPainterPath,&#13;
    QPolygonF,&#13;
)&#13;
from qgis.core import (&#13;
    QgsProject,&#13;
    QgsExpressionContextUtils,&#13;
    QgsExpression,&#13;
    QgsFeatureRequest,&#13;
    QgsMessageLog,&#13;
    QgsVariantUtils,&#13;
    QgsVectorLayer,&#13;
    Qgis,&#13;
)&#13;
from qgis.utils import iface&#13;
&#13;
&#13;
# ---------------- Stable values ----------------&#13;
__UDK_LEVELS = ("All", "Upperdark", "Middledark", "Lowerdark")&#13;
__LANGS = ("en", "ru", "it")&#13;
__EDITIONS = ("All", "2e", "3e", "5e")&#13;
__MEASURE_SYSTEMS = ("metric", "imperial")&#13;
&#13;
__MEASURE_UNITS = {&#13;
    "metric": {&#13;
        "distance": Qgis.DistanceUnit.Kilometers,&#13;
        "area": Qgis.AreaUnit.SquareKilometers,&#13;
    },&#13;
    "imperial": {&#13;
        "distance": Qgis.DistanceUnit.Miles,&#13;
        "area": Qgis.AreaUnit.SquareMiles,&#13;
    },&#13;
}&#13;
