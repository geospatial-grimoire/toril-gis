        <field comment="" expression="&quot;geog_extent&quot; ['centroid']['md']" length="-1" name="centroid" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="CASE &#13;&#10;    WHEN geometry_type(@geometry) = 'Polygon' &#13;&#10;    THEN CONCAT(&#13;&#10;        'perimeter: ', &quot;geog_extent&quot;['perimeter'][@TG_CONFIG_MEASURE_SYSTEM], ' ', EVAL(@tg_f_measure_length_unit),&#13;&#10;        ' | area: ', &quot;geog_extent&quot;['area'][@TG_CONFIG_MEASURE_SYSTEM], ' ', EVAL(@tg_f_measure_area_unit)&#13;&#10;    )&#13;&#10;    WHEN geometry_type(@geometry) = 'Line' &#13;&#10;    THEN CONCAT(&#13;&#10;        'length: ', &quot;geog_extent&quot;['length'][@TG_CONFIG_MEASURE_SYSTEM ], ' ', EVAL(@tg_f_measure_length_unit)&#13;&#10;    )&#13;&#10;    ELSE NULL&#13;&#10;END" length="-1" name="measurements" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="array_to_string(coalesce(map_get(&quot;location_paths&quot;, @TG_CONFIG_LANG), map_get(&quot;location_paths&quot;, 'en')), ' → ')" length="-1" name="location" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="with_variable(&#13;&#10;    'source_feature',&#13;&#10;    get_feature('Map Sources', 'uuid', attribute($currentfeature, 'source')),&#13;&#10;    format(&#13;&#10;        '&lt;a href=''%1''&gt;%2 %3&lt;/a&gt;',&#13;&#10;        attribute(@source_feature, 'url'),&#13;&#10;        attribute(@source_feature, 'title'),&#13;&#10;        attribute(@source_feature, 'descr')&#13;&#10;    )&#13;&#10;)" length="-1" name="source_citation" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="with_variable(&#13;&#10;    'source_feature',&#13;&#10;    get_feature('Map Sources', 'uuid', attribute($currentfeature, 'source')),&#13;&#10;    format(&#13;&#10;        '&lt;a href=''%1''&gt;%2 %3&lt;/a&gt;',&#13;&#10;        attribute(@source_feature, 'url'),&#13;&#10;        attribute(@source_feature, 'title'),&#13;&#10;        attribute(@source_feature, 'descr')&#13;&#10;    )&#13;&#10;)" length="-1" name="source_citation" precision="0" subType="0" type="10" typeName="text"/>
        <field comment="" expression="-- This expression generates an HTML hyperlink for the usage terms.&#13;&#10;-- It performs a two-step lookup: first to 'map_sources' to get the&#13;&#10;-- 'usage_terms' uuid, and then to the 'usage_terms' layer to get the final details.&#13;&#10;&#13;&#10;with_variable(&#13;&#10;    'usage_terms_uuid',&#13;&#10;    attribute(get_feature('Map Sources', 'uuid', attribute($currentfeature, 'source')), 'usage_terms'),&#13;&#10;    with_variable(&#13;&#10;        'terms_feature',&#13;&#10;        get_feature('Usage Terms', 'uuid', @usage_terms_uuid),&#13;&#10;        format(&#13;&#10;            '&lt;a href=''%1''&gt;%2&lt;/a&gt;',&#13;&#10;            attribute(@terms_feature, 'url'),&#13;&#10;            attribute(@terms_feature, 'descr')&#13;&#10;        )&#13;&#10;    )&#13;&#10;)" length="-1" name="usage_terms" precision="0" subType="0" type="10" typeName="text"/>
