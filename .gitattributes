# Geospatial Grimoire Git LFS configuration
# Tracks large geospatial and archive files using Git LFS.

# QGIS project files and attachments
*.qgs filter=lfs diff=lfs merge=lfs -text
*.qgz filter=lfs diff=lfs merge=lfs -text

# GeoPackage files (GPKG)
*.gpkg filter=lfs diff=lfs merge=lfs -text

# GeoTIFF files (for rasters like DEMs or basemaps)
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# Georeferenced JPEG images and their world files
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.jgw filter=lfs diff=lfs merge=lfs -text

# Georeferenced PNG images and their world files
*.png filter=lfs diff=lfs merge=lfs -text
*.pgw filter=lfs diff=lfs merge=lfs -text

# Compressed archives (e.g., shapefiles, large datasets)
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
